# Copy to .env and fill in real values. NEVER commit .env.
# Every key below is read in server/configs/openai.ts, server/lib/auth.ts,
# server/lib/prisma.ts or server.ts.

# ---- Database ----
# Postgres / Neon connection string. Used by the Prisma client and
# prisma.config.ts. Use the POOLED (-pooler) host for a long-running server.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Auth ----
# better-auth signing secret. Generate with: openssl rand -base64 32
# Changing it invalidates every existing session.
BETTER_AUTH_SECRET=""

# Public base URL of THIS API — no trailing slash.
# Local: http://localhost:3000   Production: https://your-api.onrender.com
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated origins of the FRONTEND. Feeds both CORS (server.ts) and
# better-auth trustedOrigins (lib/auth.ts); both trim whitespace, but keep it
# tidy. No trailing slashes. Leave this empty and every browser request 403s.
# Production example:
#   TRUSTED_ORIGINS="https://paruai.vercel.app,https://www.paruai.com"
TRUSTED_ORIGINS="http://localhost:5173"

# "production" switches the session cookie to secure + sameSite=none, which is
# REQUIRED when the client and API sit on different domains (Vercel + Render).
# It also means the cookie is dropped over plain http — keep "development"
# locally. Most hosts set this for you; set it explicitly to be sure.
NODE_ENV="development"

# API key for the hosted Better Auth dashboard (https://dash.better-auth.com),
# in the form ba_… . Read straight out of the environment by the dash() plugin
# in lib/auth.ts — the plugin call passes no apiKey, so THIS NAME is the wiring.
# Optional: leave it empty and auth works exactly as before, just without the
# dashboard connection.
BETTER_AUTH_API_KEY=""

# ---- Social sign-in (optional) ----
# Google + GitHub OAuth. Set BOTH the id and the secret for a provider, or
# NEITHER — a half-configured provider is worse than an absent one, because
# better-auth only logs a warning for a missing clientId and still registers it,
# so the button renders and dead-ends on the provider's invalid_client page.
# lib/socialProviders.ts enforces this, and GET /api/public/config reports the
# live list so the client only renders buttons the server can service. That also
# means enabling a provider is a server restart, NOT a client redeploy.
#
# The redirect/callback URL you register with the provider points at THIS API
# (never at the client), and /api/auth is better-auth's basePath:
#   http://localhost:3000/api/auth/callback/google
#   https://your-api.onrender.com/api/auth/callback/google
#
# Google:  console.cloud.google.com -> APIs & Services -> Credentials ->
#          OAuth client ID -> Web application. Configure the consent screen with
#          scopes openid/email/profile. While it is in "Testing", only accounts
#          listed under Test users can sign in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GitHub: github.com/settings/developers -> OAuth Apps -> New OAuth App.
#         GitHub allows only ONE callback URL per app, so create a second app if
#         you want local development to work too.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---- Email (forgot-password reset + email verification) ----
# Email is sent via Brevo's transactional HTTP API (https://api.brevo.com), NOT
# SMTP. lib/email.ts sends the "reset your password" link that better-auth's
# sendResetPassword callback (lib/auth.ts) generates. HTTP is used because
# Render's free tier blocks outbound SMTP ports (25/465/587) as of 2025-09-26,
# which made a nodemailer SMTP connection hang forever.
#
# BREVO_API_KEY: create a free Brevo account, verify a sender under Settings ->
# Senders & Domains (a single Gmail sender works, no domain needed), then create
# a key under Settings -> SMTP & API -> API Keys (form: xkeysib-...).
BREVO_API_KEY=""
# The "From" address on outgoing mail — MUST be a sender verified in Brevo.
# Falls back to SMTP_USER if unset.
SMTP_FROM=""
SMTP_USER=""

# Public origin of the FRONTEND. Used to build the password-reset link, the
# email-verification callback, and the OAuth error redirect — so all three land
# on the client instead of on this API. If unset, the first TRUSTED_ORIGINS entry
# is used, then http://localhost:5173.
#
# NO TRAILING SLASH: better-auth's originCheck compares against new URL(x).origin,
# which never has one, so "https://app.vercel.app/" answers 403
# INVALID_CALLBACK_URL. The value must also appear in TRUSTED_ORIGINS, or the
# verification callback is rejected for the same reason.
#
# Now that verification mail points here, set this explicitly rather than relying
# on TRUSTED_ORIGINS ordering.
CLIENT_URL=""

# Legacy SMTP vars — NO LONGER USED for sending (kept only as a fallback source
# for the sender address above). Safe to leave empty or remove.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_PASS=""

# ---- AI (OpenRouter) ----
# OpenRouter API key (the OpenAI SDK is pointed at openrouter.ai/api/v1).
# Get one at https://openrouter.ai/keys
AI_API_KEY=""

# Optional. Generation model; defaults to poolside/laguna-s-2.1:free, which was
# measured at ~37-72s for a full page and does return raw un-fenced HTML.
#
# Free-tier slugs get withdrawn without notice and are rate-limited under load
# (OpenRouter answers 429 "temporarily rate-limited upstream"). When every
# generation starts failing, check the key and the slug FIRST:
#   curl -s https://openrouter.ai/api/v1/models | grep -o '"id":"[^"]*:free"'
#
# Other free slugs verified to return clean HTML for this prompt:
#   nvidia/nemotron-3-super-120b-a12b:free
#   cohere/north-mini-code:free
#   openai/gpt-oss-20b:free
# A paid key and a stronger model give markedly better sites and far fewer 429s.
AI_MODEL="poolside/laguna-s-2.1:free"

# Optional. Pause before the first completion, to dodge free-tier rate limits.
# Set to 0 on a paid key.
AI_RATE_LIMIT_DELAY_MS="4000"

# Optional. Per-request ceiling, default 300000 (5 min), and retry count,
# default 2. Generation on a free model really can take minutes, so keep this
# generous; it only bounds the hang case. Without a bound, a stalled provider
# leaves the project at current_code: null with no [generation-failed] marker
# and the client polls forever.
AI_REQUEST_TIMEOUT_MS="300000"
AI_MAX_RETRIES="2"

# Optional, default 90000 (90s). Inactivity bound on a STREAMING completion: if
# no token arrives for this long the stream is aborted and the generation takes
# the normal refund + [generation-failed] path. Separate from
# AI_REQUEST_TIMEOUT_MS, which the SDK applies to the request as a whole.
AI_STREAM_IDLE_TIMEOUT_MS="90000"

# ---- Server ----
# Optional, default true. On boot, any project still marked pending/generating
# belongs to a generation that died with the previous process, so it is marked
# failed and the credits are refunded (otherwise the client polls forever — the
# project would sit at current_code: null with no marker and no refund).
#
# ASSUMES A SINGLE INSTANCE, which is what Render's free plan runs. Set this to
# "false" before scaling out, or a booting instance will treat another
# instance's in-flight generations as stranded.
GENERATION_SWEEP_ON_BOOT="true"

# Optional. Defaults to 3000. Render/Railway inject their own PORT — do not
# hardcode it there.
PORT="3000"
